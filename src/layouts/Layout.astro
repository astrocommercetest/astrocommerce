---
import "../styles/global.css";
import { Font } from "astro:assets";
import { db, Collections, Brands } from "astro:db";
import Navigation from "../features/navigation/Navigation.tsx";
import { buildMenu } from "../features/navigation/buildMenu";
import CartSidePanel from "../features/cart/CartSidePanel.tsx";
import Toaster from "../features/toasts/Toaster";

interface LayoutProps {
  title?: string;
  slogan?: string;
  description?: string;
}
const { title, slogan, description } = Astro.props as LayoutProps;
const [collections, brands] = await Promise.all([
  db.select().from(Collections),
  db.select().from(Brands),
]);
const menuItems = buildMenu(collections, brands);
const baseTitle = "AstroCommerce";
const baseSlogan = "Astro Commerce";
const baseDescription =
  "Discover our exclusive collection of Astro-themed merchandise, from apparel to accessories. Shop now and show off your love for Astro in style!";
const pageTitle = `${title ?? baseTitle} - ${slogan ?? baseSlogan}`;
---

<!doctype html>
<html lang="it">
  <head>
    <Font cssVariable="--font-roboto" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? baseDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navigation items={menuItems} siteTitle={baseTitle} client:load />
    <main class="max-w-4xl mx-auto px-6 mt-8 md:mt-16">
      <slot />
    </main>
    <CartSidePanel client:only="react" />
    <Toaster client:only="react" />
  </body>
</html>
