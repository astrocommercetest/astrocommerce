---
import { cloudinaryImagePath } from "../lib/cloudinary";
import { db, eq, Products, Variants, Skus } from "astro:db";
import Layout from "../layouts/Layout.astro";

const rows = await db
  .select()
  .from(Products)
  .leftJoin(Skus, eq(Skus.id, Products.defaultSkuId))
  .leftJoin(Variants, eq(Variants.id, Skus.variantId));

const list = rows
  .filter(({ Products: p }) => p.published !== false && !p.deletedAt)
  .map(({ Products: p, Skus: s, Variants: v }) => ({
    ...p,
    imageId: (v?.imageIds as string[] | null)?.[0],
    price: s?.price ?? null,
    href: `/products/${p.slug}`,
  }));
---

<Layout title="Products">
  <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
    {
      list.map((p) => (
        <li>
          <a href={p.href} class="group block">
            <img
              src={cloudinaryImagePath(
                "w_400,h_400,c_thumb,q_auto,f_auto",
                p.imageId,
              )}
              alt={p.name}
              class="object-cover"
            />
            <div class="mt-2">
              <p class="font-medium truncate">{p.name}</p>
              {p.price != null && (
                <p class="text-sm text-gray-500">€{p.price.toFixed(2)}</p>
              )}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
