---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../features/auth/RegisterForm";

const redirectTo = Astro.url.searchParams.get("redirect") ?? "/";

if (Astro.locals.user) {
  return Astro.redirect(redirectTo);
}
---

<Layout title="Registrati">
  <div class="max-w-lg mx-auto p-16 border border-gray-300">
    <h1 class="text-2xl font-bold mb-6">Crea un account</h1>
    <RegisterForm client:load redirectTo={redirectTo} />
  </div>
</Layout>
